# ELEKEZA — hosted staging environment template
#
# Copy to .env on the staging host, fill in the values from the approved secret
# store, then: chmod 600 .env
#
#   cp docs/operations/ELEKEZA_STAGING_ENV_TEMPLATE.env .env
#
# THIS FILE CONTAINS NO SECRETS AND MUST NEVER CONTAIN ANY.
# Every value below is a placeholder. .env is git-ignored; do not commit it.
# Generated values (JWT_SECRET, DB_PASSWORD, REDIS_PASSWORD, AI_INTERNAL_SECRET)
# should be at least 32 random characters, e.g. `openssl rand -base64 48`.

# ---------------------------------------------------------------- identity
# Public origin of the staging site. Must match the CORS origin exactly.
FRONTEND_URL=https://staging.example.org
CORS_ALLOWED_ORIGINS=https://staging.example.org
NEXT_PUBLIC_API_URL=https://staging.example.org/api

# TLS override (docker-compose.tls.yml)
NGINX_DOMAIN=staging.example.org
TLS_CERT_HOST_DIR=/srv/elekeza/certbot

# ---------------------------------------------------------------- database
DB_NAME=elekeza_staging
DB_USER=elekeza
DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# Demo seed MUST stay FALSE on any host reachable from the internet.
# DemoSeedGuard refuses to start a prod-profile app with it enabled.
DEMO_SEED_ENABLED=FALSE

# Secure cookies must stay true on a TLS host. The local staging gate sets it
# false only because it serves plaintext HTTP on loopback.
SECURE_COOKIES=true

# ---------------------------------------------------------------- secrets
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
AI_INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# ---------------------------------------------------------------- AI service
AI_PROVIDER=REPLACE_WITH_PROVIDER
AI_API_KEY=REPLACE_WITH_PROVIDER_KEY
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------------------------------------------------------------- messaging (sandbox only)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
AFRICA_TALKING_API_KEY=
AFRICA_TALKING_SENDER_ID=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------- storage
STORAGE_PROVIDER=mock
R2_ENDPOINT=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- payments
# Keep mock until the pilot is explicitly authorised to take money.
FEES_MPESA_MODE=mock
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://staging.example.org/api/mpesa/callback

# ---------------------------------------------------------------- observability
SENTRY_DSN_BACKEND=
SENTRY_DSN_AI=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------- images
# Leave empty to build locally from ./backend, ./ai-elewa, ./frontend.
BACKEND_IMAGE=
AI_IMAGE=
FRONTEND_IMAGE=
IMAGE_TAG=staging
