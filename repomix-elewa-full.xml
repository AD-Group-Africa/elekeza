import httpx
import json
import time
import statistics
from datetime import datetime
from pathlib import Path

BASE_URL = "http://localhost:8000"
AUTH_HEADER = {"X-Internal-Key": "AO2xgxEVnV2r6ySzhajgl8M98aSQp3wD"}
