    # ── /ai/quiz/wrong-answer-flow ────────────────────────────────────────
    print(f"\n📋 /ai/quiz/wrong-answer-flow")

    results["wrong_answer_flow"] = run_scenario(
        name="quiz/wrong-answer-flow — both calls parallel",
        url=f"{BASE_URL}/ai/quiz/wrong-answer-flow",
