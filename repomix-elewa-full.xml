    )

    # ── /ai/quiz/generate ─────────────────────────────────────────────────
    print(f"\n📋 /ai/quiz/generate")

    results["quiz_generate"] = run_scenario(
        name="quiz/generate — 5 questions",
        url=f"{BASE_URL}/ai/quiz/generate",
        payload={
            "learner_context": VALID_CONTEXT,
