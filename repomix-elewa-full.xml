    fun updateSimplified(
        @Param("id") id: Long,
        @Param("text") text: String,
        @Param("wordCount") wordCount: Int,
        @Param("status") status: ContentStatus,
        @Param("now") now: LocalDateTime = LocalDateTime.now()
    ): Int
