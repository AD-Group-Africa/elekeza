# Elekeza — environment template (copy to `.env` and fill in real values).
# Never commit real secrets. All values below are placeholders or safe defaults.

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DB_NAME=elekeza
DB_USER=postgres
DB_PASSWORD=<replace-with-production-db-password>

# ── Redis (optional cache) ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<replace-with-production-redis-password>

# ── Backend security ──────────────────────────────────────────────────────
# 32+ character random string. Generate with: openssl rand -base64 48
JWT_SECRET=<generate-a-64-char-random-secret>

# Internal secret shared between the Spring Boot backend and the AI service.
# Must be identical to INTERNAL_SECRET in ai-elewa/.env.
AI_INTERNAL_SECRET=<generate-a-32-char-random-secret>

# ── AI service ────────────────────────────────────────────────────────────
AI_PROVIDER=groq
AI_API_KEY=<replace-with-valid-groq-api-key>

# ── URLs / CORS ───────────────────────────────────────────────────────────
# Bare backend origin (no /api suffix): axios uses baseURL '/api' and Next.js
# rewrites /api/* to ${NEXT_PUBLIC_API_URL}/api/* — an /api suffix would
# double-prefix the path.
NEXT_PUBLIC_API_URL=https://<production-backend-domain>
FRONTEND_URL=https://<production-frontend-domain>
CORS_ALLOWED_ORIGINS=https://<production-frontend-domain>
SECURE_COOKIES=true

# ── External provider backends (all default to safe in-memory "mock") ─────
# sms.provider:    mock | africa_talking
# email.provider:  mock | javamail
# storage.provider: mock | cloudflare_r2
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
STORAGE_PROVIDER=mock

# Africa's Talking (only when SMS_PROVIDER=africa_talking)
AFRICA_TALKING_API_KEY=
AFRICA_TALKING_SENDER_ID=Elekeza

# SMTP (only when EMAIL_PROVIDER=javamail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudflare R2 (only when STORAGE_PROVIDER=cloudflare_r2)
# R2_ENDPOINT may be left blank; it is then derived from the account ID.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=elekeza-uploads
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# ── Optional integrations ─────────────────────────────────────────────────
# M-Pesa Daraja (only when M-Pesa payments are enabled)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://<production-backend-domain>/api/payments/callback

# Google OAuth (only when social login is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry (optional error tracking)
SENTRY_DSN_BACKEND=
SENTRY_DSN_AI=
NEXT_PUBLIC_SENTRY_DSN=

# Langfuse (optional AI observability)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
