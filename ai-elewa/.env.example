# Elekeza AI service — environment template (copy to `.env` and fill in).
# Never commit real secrets.

# Provider: groq | openai | anthropic | google
AI_PROVIDER=groq

# Provider API key (Groq: https://console.groq.com)
AI_API_KEY=<replace-with-valid-groq-api-key>

# Internal security — shared with the Spring Boot backend. Must be identical
# to AI_INTERNAL_SECRET in the backend environment.
INTERNAL_SECRET=<generate-a-32-char-random-secret>

# Langfuse observability (optional — leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# tesseract OCR binary (optional — leave blank to use the default)
TESSERACT_CMD=
