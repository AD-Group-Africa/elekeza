import os
import pytest
from pathlib import Path
from unittest.mock import patch, MagicMock

from utils.ocr import _clean_ocr_output, extract_text_from_image
from models.errors import AIServiceError, ERROR_OCR_FAILED


# ---------------------------------------------------------------------------
