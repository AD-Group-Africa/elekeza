<file path="docker-compose.yml">
services:
  postgres:
    image: postgres:16-alpine
    container_name: elewa-postgres
    environment:
      POSTGRES_DB: accessibledocs
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${DB_PASSWORD:-password}
    ports:
      - "5433:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5

  backend:
    build: ./backend
    container_name: elewa-backend
    ports:
      - "8080:8080"
    environment:
      SPRING_PROFILES_ACTIVE: docker
      DB_PASSWORD: ${DB_PASSWORD:-password}
      DB_USERNAME: ${DB_USERNAME:-postgres}
      DB_NAME: ${DB_NAME:-accessibledocs}
      AI_SERVICE_URL: http://ai-service:8000
      AI_INTERNAL_SECRET: ${INTERNAL_SECRET:-change-me-shared-secret}
      CORS_ALLOWED_ORIGINS: http://localhost:3000,http://frontend:3000
      JWT_SECRET: ${JWT_SECRET:-change-me-32-char-minimum-secret-key}
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/actuator/health"]
      interval: 10s
      timeout: 5s
      retries: 5

  ai-service:
    build: ./ai-elewa
    container_name: elewa-ai
    ports:
      - "8000:8000"
    environment:
      AI_PROVIDER: groq
      AI_API_KEY: ${GROQ_API_KEY}
      INTERNAL_SECRET: ${INTERNAL_SECRET:-change-me-shared-secret}
      LANGFUSE_HOST: http://langfuse:3000
      TESSERACT_CMD:  # empty for Docker auto-detect
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 10s
      timeout: 5s
      retries: 3

  frontend:
    build: ./frontend
    container_name: elewa-frontend
    ports:
      - "3000:3000"
    depends_on:
      - backend

volumes:
  postgres_data:
