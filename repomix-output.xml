import { getHomePathForRole } from '@/lib/roleAuth'

export default function Home() {
  const { user, loading } = useAuth()
  const router = useRouter()

  useEffect(() => {
    if (!loading) {
      if (user) {
        router.push(getHomePathForRole(user.role))
      } else {
        router.push('/login')
      }
    }
  }, [user, loading, router])

  // Show loading while checking auth
  return (
    <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-elekeza-deep-blue via-white to-elekeza-indigo">
      <div className="text-center">
