      <div className="grid gap-3 md:grid-cols-2">
        <ModeToggle
          title="Calm UI"
          subtitle="Softer visuals and reduced stimulation"
          active={calmUI}
          onToggle={onCalmToggle}
          icon={<AdjustmentsHorizontalIcon className="h-5 w-5" />}
        />
        <ModeToggle
          title="Focus Mode"
