{
  "authorized": false,
  "reason": "Missing required claim: scope:admin",
  "required_claims": ["scope:admin", "capability:swarm_create"],
  "agent_claims": ["scope:read", "scope:write"],
  "suggestion": "Request elevation or use coordinator agent"
}
```
