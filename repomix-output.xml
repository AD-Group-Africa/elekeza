      --session-id "api-docs-$(date +%s)" \
      --task "Documentation: $TASK" \
      --output "Failed: {{error_message}}" \
      --reward "0.0" \
      --success "false" \
      --critique "Error: {{error_message}}" 2>/dev/null || true
