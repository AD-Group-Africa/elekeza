import { chromium } from 'playwright-core'
const browser = await chromium.launch()
const page = await browser.newPage({ viewport: { width: 1366, height: 900 } })
await page.goto('http://localhost:3100/login')
await page.getByPlaceholder('Enter your email').fill('teacher@elekeza.app')
await page.getByPlaceholder('Enter your password').fill('teacher123')
await page.getByRole('button', { name: 'Login' }).click()
await page.waitForURL(/\/teacher/, { timeout: 45000 })
await page.waitForLoadState('networkidle').catch(() => {})
const img = page.locator('aside img[alt="Elekeza"]')
await img.waitFor({ timeout: 15000 })
const box = await img.boundingBox()
console.log('sidebar logo box:', JSON.stringify(box))
await page.screenshot({ path: '../artifacts/exhibition-qa/logo-sidebar-desktop.png' })
// collapsed state
await page.locator('aside button[aria-label*="Collapse"]').click().catch(e => console.log('collapse btn:', String(e).slice(0, 80)))
await page.waitForTimeout(600)
await page.screenshot({ path: '../artifacts/exhibition-qa/logo-sidebar-collapsed.png' })
// guardian role check
await page.goto('http://localhost:3100/login'); await page.waitForTimeout(500)
await page.evaluate(() => localStorage.clear()); await page.context().clearCookies()
await page.goto('http://localhost:3100/login')
await page.getByPlaceholder('Enter your email').fill('parent@elekeza.app')
await page.getByPlaceholder('Enter your password').fill('parent123')
await page.getByRole('button', { name: 'Login' }).click()
await page.waitForURL(/\/guardian/, { timeout: 45000 }).catch(() => {})
await page.waitForTimeout(2500)
await page.screenshot({ path: '../artifacts/exhibition-qa/logo-sidebar-guardian.png' })
// mobile student
await page.setViewportSize({ width: 390, height: 844 })
await page.evaluate(() => localStorage.clear()); await page.context().clearCookies()
await page.goto('http://localhost:3100/login')
await page.getByPlaceholder('Enter your email').fill('student@elekeza.app')
await page.getByPlaceholder('Enter your password').fill('student123')
await page.getByRole('button', { name: 'Login' }).click()
await page.waitForURL(/student-home/, { timeout: 45000 }).catch(() => {})
await page.waitForTimeout(2500)
await page.screenshot({ path: '../artifacts/exhibition-qa/logo-mobile-student.png' })
await browser.close()
console.log('done')
